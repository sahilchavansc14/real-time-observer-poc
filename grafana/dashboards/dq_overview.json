{
  "title": "Data Quality \u2014 Live Pipeline",
  "uid": "rt-dq-obs",
  "schemaVersion": 38,
  "version": 6,
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "timezone": "browser",
  "tags": [
    "data-quality",
    "streaming"
  ],
  "editable": true,
  "panels": [
    {
      "type": "stat",
      "title": "Total Records Processed",
      "id": 1,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "expr": "sum(dq_records_processed_total)",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "area"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        }
      }
    },
    {
      "type": "stat",
      "title": "Clean Records",
      "id": 2,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "targets": [
        {
          "expr": "sum(dq_records_clean_total)",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "area"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "green"
          }
        }
      }
    },
    {
      "type": "stat",
      "title": "Bad Records",
      "description": "Records that failed validation and were quarantined.",
      "id": 3,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "expr": "sum(dq_records_quarantined_total)",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "area"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 50
              }
            ]
          }
        }
      }
    },
    {
      "type": "stat",
      "title": "Bad Record Rate",
      "description": "Percentage of records that failed validation in the last batch.",
      "id": 4,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "targets": [
        {
          "expr": "dq_quarantine_rate_pct",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 5
              },
              {
                "color": "red",
                "value": 15
              }
            ]
          }
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Clean vs Bad Records Over Time",
      "description": "How many records are passing vs failing validation per minute.",
      "id": 5,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 9,
        "w": 14,
        "x": 0,
        "y": 5
      },
      "targets": [
        {
          "expr": "rate(dq_records_clean_total[1m]) * 60",
          "refId": "A",
          "legendFormat": "Clean"
        },
        {
          "expr": "sum(rate(dq_records_quarantined_total[1m])) * 60",
          "refId": "B",
          "legendFormat": "Bad (quarantined)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Bad (quarantined)"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "red",
                  "mode": "fixed"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Clean"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "green",
                  "mode": "fixed"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "type": "bargauge",
      "title": "Where Are the Bad Records? (by reason)",
      "description": "Which validation rule is causing the most failures in the last 30 minutes.",
      "id": 6,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 9,
        "w": 10,
        "x": 14,
        "y": 5
      },
      "targets": [
        {
          "expr": "sort_desc(sum by (reason) (increase(dq_records_quarantined_total[30m])))",
          "refId": "A",
          "legendFormat": "{{reason}}"
        }
      ],
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "color": {
            "mode": "continuous-RdYlGr"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        }
      }
    },
    {
      "type": "table",
      "title": "DQ Rule Status \u2014 which checks are failing right now",
      "description": "Each row is one Soda check. Green = passing, Red = failing. Measured value vs threshold shows how close to the limit you are.",
      "id": 7,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 10,
        "w": 14,
        "x": 0,
        "y": 14
      },
      "targets": [
        {
          "expr": "dq_check_status",
          "refId": "A",
          "format": "table",
          "instant": true,
          "legendFormat": ""
        },
        {
          "expr": "dq_metric_value",
          "refId": "B",
          "format": "table",
          "instant": true,
          "legendFormat": ""
        },
        {
          "expr": "dq_metric_threshold",
          "refId": "C",
          "format": "table",
          "instant": true,
          "legendFormat": ""
        }
      ],
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "rule_id",
            "mode": "outer"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Time 1": true,
              "Time 2": true,
              "Time 3": true,
              "__name__": true,
              "instance": true,
              "job": true,
              "pipeline_id": true,
              "pipeline_id 1": true,
              "pipeline_id 2": true,
              "pipeline_id 3": true,
              "dq_dimension 2": true,
              "dq_dimension 3": true
            },
            "indexByName": {
              "rule_id": 0,
              "dq_dimension 1": 1,
              "Value #A": 2,
              "Value #B": 3,
              "Value #C": 4
            },
            "renameByName": {
              "rule_id": "Check",
              "dq_dimension 1": "Category",
              "Value #A": "Status",
              "Value #B": "Measured",
              "Value #C": "Threshold"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "left"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Status"
            },
            "properties": [
              {
                "id": "custom.displayMode",
                "value": "color-background"
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "red",
                      "value": null
                    },
                    {
                      "color": "green",
                      "value": 1
                    }
                  ]
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "0": {
                        "text": "FAILING"
                      },
                      "1": {
                        "text": "PASSING"
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.width",
                "value": 100
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Category"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 110
              }
            ]
          }
        ]
      }
    },
    {
      "type": "timeseries",
      "title": "Null % in Key Fields Over Time",
      "description": "Tracks missing value % per field so you can see when data starts going null.",
      "id": 8,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 10,
        "w": 10,
        "x": 14,
        "y": 14
      },
      "targets": [
        {
          "expr": "dq_metric_value{rule_id=\"R-COMPL-001\"}",
          "refId": "A",
          "legendFormat": "customer_id null %"
        },
        {
          "expr": "dq_metric_value{rule_id=\"R-COMPL-004\"}",
          "refId": "B",
          "legendFormat": "email null %"
        },
        {
          "expr": "dq_metric_value{rule_id=\"R-VALID-001\"}",
          "refId": "C",
          "legendFormat": "invalid email format %"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 3
              },
              {
                "color": "red",
                "value": 5
              }
            ]
          }
        }
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        }
      }
    }
  ]
}